<form action="applyCreditCard"
method="post">

<input type="text"
name="customerId"
class="form-control"
placeholder="Customer ID">

<select
name="cardType"
class="form-control mt-2">

<option>Silver</option>
<option>Gold</option>
<option>Platinum</option>

</select>

<input type="text"
name="creditLimit"
class="form-control mt-2"
placeholder="Credit Limit">

<button
class="btn btn-primary mt-3">

Apply Credit Card

</button>

</form>