<form action="addBeneficiary"
method="post">

<input type="hidden"
name="customerId"
value="1">

<input type="text"
name="beneficiaryName"
placeholder="Beneficiary Name"
required>

<input type="text"
name="accountNumber"
placeholder="Account Number"
required>

<input type="text"
name="ifscCode"
placeholder="IFSC Code"
required>

<input type="text"
name="bankName"
placeholder="Bank Name"
required>

<input type="text"
name="mobileNumber"
placeholder="Mobile Number"
required>

<button type="submit">
Add Beneficiary
</button>

</form>