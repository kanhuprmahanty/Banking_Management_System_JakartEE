<form action="addEmployee"
method="post">

<input type="text"
name="firstName"
placeholder="First Name"
class="form-control">

<input type="text"
name="lastName"
placeholder="Last Name"
class="form-control mt-2">

<input type="email"
name="email"
placeholder="Email"
class="form-control mt-2">

<input type="text"
name="mobile"
placeholder="Mobile"
class="form-control mt-2">

<input type="text"
name="department"
placeholder="Department"
class="form-control mt-2">

<input type="text"
name="designation"
placeholder="Designation"
class="form-control mt-2">

<input type="text"
name="salary"
placeholder="Salary"
class="form-control mt-2">

<input type="text"
name="username"
placeholder="Username"
class="form-control mt-2">

<input type="password"
name="password"
placeholder="Password"
class="form-control mt-2">

<select
name="role"
class="form-control mt-2">

<option>KYC_OFFICER</option>
<option>LOAN_OFFICER</option>
<option>CASHIER</option>
<option>MANAGER</option>

</select>

<button
class="btn btn-success mt-3">

Add Employee

</button>

</form>