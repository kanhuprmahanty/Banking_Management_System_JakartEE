<form action="addNominee"
method="post">

<input type="text"
name="customerId"
class="form-control"
placeholder="Customer ID">

<input type="text"
name="nomineeName"
class="form-control mt-2"
placeholder="Nominee Name">

<input type="text"
name="relationship"
class="form-control mt-2"
placeholder="Relationship">

<input type="text"
name="mobile"
class="form-control mt-2"
placeholder="Mobile Number">

<input type="email"
name="email"
class="form-control mt-2"
placeholder="Email">

<textarea
name="address"
class="form-control mt-2"
placeholder="Address"></textarea>

<input type="number"
step="0.01"
name="share"
class="form-control mt-2"
placeholder="Share Percentage">

<button
class="btn btn-primary mt-3">

Add Nominee

</button>

</form>