<form action="addBranch"
method="post">

<input type="text"
name="branchName"
class="form-control"
placeholder="Branch Name">

<input type="text"
name="branchCode"
class="form-control mt-2"
placeholder="Branch Code">

<input type="text"
name="managerName"
class="form-control mt-2"
placeholder="Manager Name">

<input type="email"
name="email"
class="form-control mt-2"
placeholder="Branch Email">

<input type="text"
name="phone"
class="form-control mt-2"
placeholder="Phone Number">

<textarea
name="address"
class="form-control mt-2"
placeholder="Address"></textarea>

<input type="text"
name="city"
class="form-control mt-2"
placeholder="City">

<input type="text"
name="state"
class="form-control mt-2"
placeholder="State">

<button
class="btn btn-success mt-3">

Add Branch

</button>

</form>